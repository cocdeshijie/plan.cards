# ── Secrets ────────────────────────────────────────────────────────────────
# Auto-generated on first run and persisted to the data volume if left as the
# default below. If you set your own, use a long random value:
#   openssl rand -base64 32
#
# Rotating this logs everyone out (expected). It does NOT break stored OAuth
# client secrets — those use a separate key at /data/.encryption_key.
SECRET_KEY=change-this-secret-key-in-production

# ── Networking ─────────────────────────────────────────────────────────────
# Host port for the standalone `docker compose up -d` topology. Ignored when
# deploying behind a reverse proxy with an explicit `-f docker-compose.yaml`.
#HOST_PORT=3000

# Cross-origin browser access to the API. Leave unset for the normal setup:
# the frontend proxies /api/* same-origin, so no CORS headers are needed.
# Only set this if you point a browser directly at the backend. Comma-separated
# origins including the scheme. "*" reflects any origin and, combined with
# credentialed requests, disables the browser's same-origin protection — do not
# use it on an untrusted network.
#ALLOWED_ORIGINS=https://cards.example.com

# ── Behaviour ──────────────────────────────────────────────────────────────
# Seconds between card-template hot-reload checks. 0 disables hot-reload.
#TEMPLATE_RELOAD_INTERVAL=30

# Set to false to disable auth rate limiting. Required when running the test
# suite; never disable it in production.
#RATE_LIMIT_ENABLED=true
